        judge = LLMStructuralJudge(clients=AnthropicClient())

        # 앙상블 (3개 모델 평균)
        judge = LLMStructuralJudge(clients=[
            AnthropicClient(),
            OpenAIClient(),
            GeminiClient(),
        ])

        # 편의 함수로 provider 이름만 전달
        judge = LLMStructuralJudge.from_providers(["anthropic", "openai"])
    """

    # ── V1 weights (preserved for backward compatibility) ──
    WEIGHTS_V1 = {
        "alignment": 0.3,
        "sequencing": 0.2,
        "investment": 0.2,
        "coherence": 0.2,
        "balance": 0.1
    }

    # ── V2 weights (new primary) ──
    WEIGHTS = {
        "trl_pathway": 0.25,
        "strategic_fidelity": 0.25,
        "competitive_awareness": 0.20,
        "market_timing": 0.20,
        "patent_market_convergence": 0.10,
    }

    # ── V1 prompt (preserved) ──
