class TRMEvaluationSuite:
    """
    전체 파이프라인 실행:
    Agent Output Normalizer
      → Constraint Checker
        → LLM Structural Judge (multi-provider)
          → Back Test Evaluator
            → Score Aggregator
              → Benchmark Report

    사용법:
        # 모드 A: rule-based (API 없이)
        suite = TRMEvaluationSuite()
        report = suite.evaluate(input_pack)

        # 모드 B: 단일 provider
        suite = TRMEvaluationSuite(providers=["anthropic"])
        report = suite.evaluate(input_pack, use_api=True)

        # 모드 C: 앙상블 (3개 모델 평균)
        suite = TRMEvaluationSuite(providers=["anthropic", "openai", "gemini"])
        report = suite.evaluate(input_pack, use_api=True)

        # 모드 D: client 객체 직접 주입 (모델 세부 제어)
        suite = TRMEvaluationSuite(clients=[
            AnthropicClient(model="claude-sonnet-4-6"),
            OpenAIClient(model="gpt-4.1"),
            GeminiClient(model="gemini-2.0-flash-001"),
        ])
        report = suite.evaluate(input_pack, use_api=True)

        # 모드 E: 점수 직접 전달
        report = suite.evaluate(input_pack, llm_scores={"alignment":4, ...})
    """

    def __init__(self,
                 providers: Optional[List[str]] = None,
                 clients: Optional[List[BaseLLMClient]] = None,
                 api_keys: Optional[Dict[str, str]] = None,
                 models: Optional[Dict[str, str]] = None,
                 aggregation: str = "mean"):
        """
        Args:
            providers: provider 이름 리스트 (예: ['anthropic', 'openai', 'gemini'])
            clients: 이미 생성된 BaseLLMClient 리스트 (providers 대신 사용)
            api_keys: {'anthropic': 'sk-...', 'openai': 'sk-...', 'gemini': '...'}
            models: {'anthropic': 'claude-opus-4', 'openai': 'gpt-4o', ...}
            aggregation: 'mean' 또는 'median' (앙상블 집계 방식)
        """
        self.normalizer = AgentOutputNormalizer()
        self.constraint_checker = ConstraintChecker()

        if clients:
            self.llm_judge = LLMStructuralJudge(clients=clients, aggregation=aggregation)
        elif providers:
            self.llm_judge = LLMStructuralJudge.from_providers(
                providers, api_keys=api_keys, models=models, aggregation=aggregation
            )
        else:
            self.llm_judge = LLMStructuralJudge()

        self.backtest = BackTestEvaluator()
        self.aggregator = ScoreAggregator()
        self.reporter = BenchmarkReportGenerator()
        self.comparator = PairwiseComparator()

    def evaluate(self, input_pack: dict,
                 llm_scores: Optional[dict] = None,
                 use_api: bool = False) -> dict:
        """Absolute 평가 실행."""
        step1 = self.normalizer.run(input_pack)
        step2 = self.constraint_checker.run(step1)
        step3 = self.llm_judge.run(step2, llm_scores=llm_scores, use_api=use_api)
        step4 = self.backtest.run(step3)
        step5 = self.aggregator.run(step4)
        report = self.reporter.run(step5)
        return report

    def compare(self, input_a: dict, input_b: dict,
                llm_scores_a: Optional[dict] = None,
                llm_scores_b: Optional[dict] = None,
                use_api: bool = False) -> dict:
        """Pairwise 비교 실행."""
        report_a = self.evaluate(input_a, llm_scores=llm_scores_a, use_api=use_api)
        report_b = self.evaluate(input_b, llm_scores=llm_scores_b, use_api=use_api)
        comparison = self.comparator.compare(report_a, report_b)
        return {
            "report_A": report_a,
            "report_B": report_b,
            "pairwise": comparison
        }

    @staticmethod
    def print_report(report: dict, indent: int = 2):
        """보고서를 예쁘게 출력"""
        print(json.dumps(report, indent=indent, ensure_ascii=False))

    @staticmethod
    def print_summary(report: dict):
        """한 눈에 보는 요약 출력"""
        m = report["metadata"]
        l = report["llm_judge"]
        b = report["backtest"]
        c = report["composite"]
        d = report["diagnostics"]

        print("=" * 60)
        print(f"  TRM Evaluation Report — {m['scenario']} / {m['domain']}")
        print("=" * 60)
        print()
        print(f"  ┌─ LLM Structural Judge ─────── {l['llm_structural_score']:>5.1f} / 100")
        print(f"  │   alignment={l['alignment']}  sequencing={l['sequencing']}  "
              f"investment={l['investment']}  coherence={l['coherence']}  balance={l['balance']}")
        print(f"  │")
        print(f"  ├─ Backtest Score ────────────── {b['backtest_score']:>5.1f} / 100")
        print(f"  │   selection_quality   = {b['selection_quality']:>5.1f}")
        print(f"  │   cost_adjusted_return= {b['cost_adjusted_return']:>5.1f}")
        print(f"  │   budget_feasibility  = {b['budget_feasibility_score']:>5.1f}")
        print(f"  │   dependency_validity = {b['dependency_validity_score']:>5.1f}")
        print(f"  │   timing_accuracy     = {b['timing_accuracy_score']:>5.1f}")
        print(f"  │")
        print(f"  ├─ Composite ─────────────────── {c['final_composite_score']:>5.1f} / 100")
        print(f"  │   pre-penalty = {c['pre_penalty_score']:.1f}")
        print(f"  │   penalty     = -{c['total_penalty']:.1f}")
        print(f"  │")
        print(f"  └─ Diagnostics")
        print(f"      {d['summary']}")
        if d["key_failure_points"]:
            for fp in d["key_failure_points"]:
                print(f"      ⚠ {fp}")
        print()


