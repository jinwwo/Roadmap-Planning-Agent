    def _rule_based_proxy(self, data: dict) -> dict:
        """
        V2 rule-based fallback: 새 5축에 대한 구조적 근사.
        LLM 호출 실패 시 사용.
        """
        techs = data["merged_techs"]
        cr = data["constraint_results"]
        meta = data.get("metadata", {})
        strategic_dir = meta.get("strategy_type", "") or meta.get("strategic_direction", "")

        # 1) trl_pathway: TRL gap / timeline 비율
        trl_scores = []
        for t in techs:
            try:
                s_year = int(t["start_q"].split("-")[0])
                t_year = int(t["target_q"].split("-")[0])
                years = max(1, t_year - s_year)
                trl = t.get("TRL", 5)
                gap = max(0, 7 - trl)  # target TRL ~7 가정
                ratio = gap / years
                if ratio <= 0.8:
                    trl_scores.append(5)
                elif ratio <= 1.2:
                    trl_scores.append(4)
                elif ratio <= 1.5:
                    trl_scores.append(3)
                elif ratio <= 2.0:
                    trl_scores.append(2)
                else:
                    trl_scores.append(1)
            except:
                trl_scores.append(3)
        trl_pathway = round(sum(trl_scores) / max(len(trl_scores), 1))

        # 2) strategic_fidelity: 전략 프로파일 매치
        is_tech_lead = "기술선도" in strategic_dir or "technology" in strategic_dir.lower()
        low_trl_count = sum(1 for t in techs if t.get("TRL", 5) <= 5)
        high_trl_count = sum(1 for t in techs if t.get("TRL", 5) >= 6)
        total = max(len(techs), 1)
        if is_tech_lead:
            match_rate = low_trl_count / total
        else:
            match_rate = high_trl_count / total
        strategic_fidelity = min(5, max(1, round(1 + match_rate * 4)))

        # 3) competitive_awareness: 기본 3점 (rule-based로는 판단 어려움)
        competitive_awareness = 3

        # 4) market_timing: 전략별 기준 적용
        timing_scores = []
        for te in cr.get("timing_errors", []):
            err = te.get("error_years", 0)
            if is_tech_lead:
                if err <= -0.5:
                    timing_scores.append(5)
                elif err <= 0.5:
                    timing_scores.append(4)
                elif err <= 1.5:
                    timing_scores.append(3)
                else:
                    timing_scores.append(max(1, 5 - int(err)))
            else:
                if abs(err) <= 0.5:
                    timing_scores.append(5)
                elif abs(err) <= 1.0:
                    timing_scores.append(4)
                elif abs(err) <= 2.0:
                    timing_scores.append(3)
                else:
                    timing_scores.append(max(1, 5 - int(abs(err))))
        market_timing = round(sum(timing_scores) / max(len(timing_scores), 1)) if timing_scores else 3

        # 5) patent_market_convergence: patent_norm × market_norm 곱 기반
        conv_scores = []
        for t in techs:
            pn = t.get("patent_growth_norm", 0.5)
            mn = t.get("market_growth_norm", 0.5)
            conv = pn * mn
            conv_scores.append(conv)
        avg_conv = sum(conv_scores) / max(len(conv_scores), 1)
        patent_market_convergence = min(5, max(1, round(1 + avg_conv * 4)))

        return {
            "trl_pathway": max(1, min(5, trl_pathway)),
            "strategic_fidelity": max(1, min(5, strategic_fidelity)),
            "competitive_awareness": max(1, min(5, competitive_awareness)),
            "market_timing": max(1, min(5, market_timing)),
            "patent_market_convergence": max(1, min(5, patent_market_convergence)),
        }

    def _rule_based_proxy_v1(self, data: dict) -> dict:
        """V1 rule-based proxy for backward-compatible v1 scores."""
        techs = data["merged_techs"]
        cr = data["constraint_results"]

        avg_market_growth = sum(t["market_growth_norm"] for t in techs) / len(techs) if techs else 0
        alignment = min(5, max(1, round(1 + avg_market_growth * 4)))

        dep_penalty = cr["dependency_violation_count"]
        sequencing = max(1, 5 - dep_penalty)

        tier_match_count = 0
        for t in techs:
            value = 0.4 * t["patent_growth_norm"] + 0.3 * t["market_growth_norm"] + 0.3 * t["market_size_norm"]
            expected_tier = "Strategic" if value > 0.75 else "High" if value > 0.5 else "Medium" if value > 0.25 else "Low"
            actual_cost = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}
            expected_cost = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}
            if abs(actual_cost.get(t["investment_tier"], 2) - expected_cost.get(expected_tier, 2)) <= 1:
                tier_match_count += 1
        investment = min(5, max(1, round(1 + (tier_match_count / max(len(techs), 1)) * 4)))

        categories = set(t["category"] for t in techs)
        trl_spread = max(t["TRL"] for t in techs) - min(t["TRL"] for t in techs) if techs else 0
        coherence_raw = min(1, len(categories) / 3) * 0.5 + min(1, trl_spread / 4) * 0.5
        coherence = min(5, max(1, round(1 + coherence_raw * 4)))

        tiers = set(t["investment_tier"] for t in techs)
        balance = min(5, max(1, round(1 + (len(tiers) / 4) * 4)))

        return {
            "alignment": alignment, "sequencing": sequencing,
            "investment": investment, "coherence": coherence, "balance": balance,
        }

    def _generate_diagnostics(self, data: dict, scores: dict) -> dict:
        techs = data["merged_techs"]
        cr = data["constraint_results"]

        strengths, weaknesses = [], []
        missing_techs, investment_issues, timing_issues = [], [], []

        if scores.get("trl_pathway", 3) >= 4:
            strengths.append("TRL progression pathways are realistic for the given timelines")
        if scores.get("strategic_fidelity", 3) >= 4:
            strengths.append("Roadmap faithfully executes the declared strategic direction")
        if scores.get("competitive_awareness", 3) >= 4:
            strengths.append("Strong competitive landscape awareness in technology selection")

        if scores.get("trl_pathway", 3) <= 2:
            weaknesses.append("Multiple TRL pathways are unrealistic for the stated timelines")
        if scores.get("strategic_fidelity", 3) <= 2:
            weaknesses.append("Significant mismatch between declared strategy and actual portfolio")
        if scores.get("market_timing", 3) <= 2:
            weaknesses.append("Systematic market timing misalignment across the portfolio")
        if scores.get("patent_market_convergence", 3) <= 2:
            weaknesses.append("Technology selections lack patent-market convergence")

        for err in cr["timing_errors"]:
            if err["error_years"] > 0.5:
                timing_issues.append(
                    f"{err['tech_name']}: 시장 개화({err['boom_q']}) 대비 "
                    f"{err['error_years']}년 지연"
                )

        return {
            "strengths": strengths,
            "weaknesses": weaknesses,
            "missing_technologies": missing_techs,
            "investment_issues": investment_issues,
            "timing_issues": timing_issues
        }


class BackTestEvaluator:
    """
    Step 4: Back Test 경제성 평가
    - §5: holdout 데이터 기반 value_i 계산
    - §6: agent 내부 점수 재사용 안 함 (독립성)
    - §8: 6개 backtest 지표 산출
    """

    LAMBDA = 0.15  # 비용 가중치

    def run(self, judged_output: dict) -> dict:
        techs = judged_output["merged_techs"]
        cr = judged_output["constraint_results"]

        # ── 기술별 value & return 계산 ──
        tech_details = []
        for t in techs:
            value = (
                0.4 * t["patent_growth_norm"]
                + 0.3 * t["market_growth_norm"]
                + 0.3 * t["market_size_norm"]
            )
            # 실제 예산(tech_budget_usd) 기반 cost_norm (케이스 내 상대 정규화)
            _budgets = [tt.get("tech_budget_usd", 0) or 0 for tt in techs]
            _max_b = max(_budgets) if any(_budgets) else 0
            if _max_b > 0:
                cost_norm = (t.get("tech_budget_usd", 0) or 0) / _max_b
            else:
                cost_norm = (t["cost_proxy"] - 1) / 3  # 예산 정보 없으면 tier fallback
            adj_return = value - self.LAMBDA * cost_norm

            tech_details.append({
                "tech_id": t["tech_id"],
                "tech_name": t["tech_name"],
                "patent_growth_norm": round(t["patent_growth_norm"], 4),
                "market_growth_norm": round(t["market_growth_norm"], 4),
                "market_size_norm": round(t["market_size_norm"], 4),
                "value": round(value, 4),
                "investment_tier": t["investment_tier"],
                "cost_proxy": t["cost_proxy"],
                "cost_norm": round(cost_norm, 4),
                "cost_adjusted_return": round(adj_return, 4)
            })

        # ── §8: 6개 지표 계산 ──

        # 1) selection_quality: 선택된 기술들의 평균 value (0~100)
        values = [td["value"] for td in tech_details]
        selection_quality = (sum(values) / len(values)) * 100 if values else 0

        # 2) cost_adjusted_return: 합산 후 정규화 (0~100)
        returns = [td["cost_adjusted_return"] for td in tech_details]
        car_raw = sum(returns) / len(returns) if returns else 0
        cost_adjusted_return = max(0, min(100, car_raw * 100))

        # 3) investment_rationality_score: §8 rule-based 기대 tier 비교
        tier_map = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}
        mismatches = 0
        tier_details = []
        for t in techs:
            value = (0.4 * t["patent_growth_norm"]
                     + 0.3 * t["market_growth_norm"]
                     + 0.3 * t["market_size_norm"])
            boom_proximity = self._boom_proximity(t)
            is_critical_dep = len([
                other for other in techs
                if t["tech_id"] in other.get("prerequisites", [])
            ]) > 0

            # 기대 tier 결정 (§8 rule-based)
            expected_level = 1
            if value > 0.5:
                expected_level += 1
            if value > 0.7:
                expected_level += 1
            if boom_proximity < 2:  # 시장 개화 2년 이내
                expected_level += 1
            if is_critical_dep:
                expected_level += 1
            if t["TRL"] >= 6:
                expected_level = max(expected_level, 2)  # 성숙 기술은 최소 Medium
            expected_level = min(4, expected_level)

            actual_level = tier_map.get(t["investment_tier"], 2)
            mismatch = abs(actual_level - expected_level)
            if mismatch > 1:
                mismatches += 1

            tier_details.append({
                "tech_id": t["tech_id"],
                "expected_level": expected_level,
                "actual_level": actual_level,
                "mismatch": mismatch
            })

        investment_rationality = (1 - mismatches / max(len(techs), 1)) * 100

        # 4) budget_feasibility_score
        budget_viol = cr["budget_violation_pct"]
        budget_feasibility = max(0, 100 - budget_viol * 2)

        # 5) dependency_validity_score
        dep_viol = cr["dependency_violation_count"]
        dependency_validity = max(0, 100 - dep_viol * 20)

        # 6) timing_accuracy_score
        mean_err = cr["mean_timing_error_years"]
        timing_accuracy = max(0, 100 - mean_err * 30)

        # ── Backtest composite (V2 가중치) ──
        bt_score = (
            0.25 * selection_quality
            + 0.25 * cost_adjusted_return
            + 0.15 * investment_rationality
            + 0.05 * budget_feasibility
            + 0.05 * dependency_validity
            + 0.25 * timing_accuracy
        )

        # ── V1 점수도 보존 ──
        bt_score_v1 = (
            0.35 * selection_quality
            + 0.35 * cost_adjusted_return
            + 0.10 * budget_feasibility
            + 0.10 * dependency_validity
            + 0.10 * timing_accuracy
        )

        return {
            **judged_output,
            "backtest": {
                "tech_details": tech_details,
                "tier_analysis": tier_details,
                "selection_quality": round(selection_quality, 1),
                "cost_adjusted_return": round(cost_adjusted_return, 1),
                "budget_feasibility_score": round(budget_feasibility, 1),
                "dependency_validity_score": round(dependency_validity, 1),
                "timing_accuracy_score": round(timing_accuracy, 1),
                "backtest_score": round(bt_score, 1),
                "backtest_score_v1": round(bt_score_v1, 1),
            }
        }

    @staticmethod
    def _boom_proximity(tech: dict) -> float:
        """시장 개화 시점까지 남은 연수"""
        try:
            year, q = tech["expected_market_boom_quarter"].split("-")
            boom = int(year) + (int(q.replace("Q", "")) - 1) * 0.25
            t_year, t_q = tech["target_q"].split("-")
            target = int(t_year) + (int(t_q.replace("Q", "")) - 1) * 0.25
            return abs(boom - target)
        except:
            return 5.0


class ScoreAggregator:
    """
    Step 5: 최종 점수 통합
    - §9: composite = 0.4 * LLM + 0.6 * Backtest - penalties
    - Hard constraint penalty 후처리
    """

    def run(self, bt_output: dict) -> dict:
        llm_score = bt_output["llm_judge"]["llm_structural_score"]
        bt_score = bt_output["backtest"]["backtest_score"]
        cr = bt_output["constraint_results"]

        # ── Penalty 계산 ──
        penalties = []
        if cr["dependency_violation_count"] > 0:
            p = cr["dependency_violation_count"] * 3
            penalties.append({"type": "dependency_violation", "amount": p})
        if cr["budget_violation_pct"] > 0:
            p = cr["budget_violation_pct"] * 0.5
            penalties.append({"type": "budget_violation", "amount": round(p, 1)})
        if cr["mean_timing_error_years"] > 1.0:
            p = (cr["mean_timing_error_years"] - 1.0) * 5
            penalties.append({"type": "timing_error", "amount": round(p, 1)})

        total_penalty = sum(p["amount"] for p in penalties)

        pre_penalty = 0.4 * llm_score + 0.6 * bt_score
        final_score = max(0, pre_penalty - total_penalty)

        return {
            **bt_output,
            "composite": {
                "pre_penalty_score": round(pre_penalty, 1),
                "penalties": penalties,
                "total_penalty": round(total_penalty, 1),
                "final_composite_score": round(final_score, 1)
            }
        }


class BenchmarkReportGenerator:
    """
    Step 6: 최종 보고서 생성
    - 깔끔한 JSON 출력 포맷 (§12)
