    def __init__(self,
                 clients: Optional[Union[BaseLLMClient, List[BaseLLMClient]]] = None,
                 aggregation: str = "mean"):
        """
        Args:
            clients: 단일 client 또는 client 리스트 (앙상블)
            aggregation: 앙상블 집계 방식 ('mean' 또는 'median')
        """
        if clients is None:
            self.clients = []
        elif isinstance(clients, BaseLLMClient):
            self.clients = [clients]
        else:
            self.clients = list(clients)
        self.aggregation = aggregation

    @classmethod
    def from_providers(cls, providers: List[str],
                       api_keys: Optional[Dict[str, str]] = None,
                       models: Optional[Dict[str, str]] = None,
                       aggregation: str = "mean") -> "LLMStructuralJudge":
        """
        Provider 이름 리스트로 간편 생성.

        Example:
            judge = LLMStructuralJudge.from_providers(
                ["anthropic", "openai", "gemini"],
                models={"openai": "gpt-4o", "gemini": "gemini-2.0-flash-001"}
            )
        """
        api_keys = api_keys or {}
        models = models or {}
        clients = [
            make_client(p, api_key=api_keys.get(p), model=models.get(p))
            for p in providers
        ]
        return cls(clients=clients, aggregation=aggregation)

    def run(self, checked_output: dict,
            llm_scores: Optional[dict] = None,
            use_api: bool = False) -> dict:
        """
        Args:
            checked_output: Constraint Checker 출력
            llm_scores: 직접 전달하는 5축 점수 dict (있으면 최우선)
            use_api: True면 등록된 client로 API 호출 (앙상블 자동 수행)
        """
        evidence = {}
        diagnostics_from_llm = {}
        per_model_scores = {}  # 앙상블 시 각 모델의 원본 점수 보관

        if llm_scores:
            # 모드 1: 직접 전달
            scores = llm_scores

        elif use_api and self.clients:
            # 모드 2 or 3: 단일 또는 앙상블 API 호출
            results = self._call_all_clients(checked_output)

            if not results:
                print(f"  ✗ 모든 client 호출 실패 → rule-based fallback")
                scores = self._rule_based_proxy(checked_output)
            else:
                # 각 모델의 점수 보관
                for provider, payload in results.items():
                    per_model_scores[provider] = {
                        axis: payload.get(axis, 3) for axis in self.WEIGHTS
                    }

                # 앙상블 집계
                scores = self._aggregate_scores(results)

                # evidence: 첫 번째 성공한 모델 것 사용 (혹은 조합 가능)
                first = next(iter(results.values()))
                evidence = first.get("evidence", {})
                diagnostics_from_llm = self._merge_diagnostics(results)

                mode_label = "앙상블" if len(results) > 1 else f"단일({list(results.keys())[0]})"
                print(f"  ✓ LLM Judge {mode_label} 완료: {list(results.keys())}")

        else:
            # 모드 4: rule-based fallback
            scores = self._rule_based_proxy(checked_output)

        # 가중합 → 0~100 변환 (V2)
        raw = sum(self.WEIGHTS[k] * scores.get(k, 3) for k in self.WEIGHTS)
        structural_score = (raw - 1) / 4 * 100

        # V1 점수도 보존: rule-based proxy로 v1 축 계산
        v1_proxy = self._rule_based_proxy_v1(checked_output)
        raw_v1 = sum(self.WEIGHTS_V1[k] * v1_proxy.get(k, 3) for k in self.WEIGHTS_V1)
        structural_score_v1 = (raw_v1 - 1) / 4 * 100

        # 진단 정보
        if diagnostics_from_llm:
            diagnostics = diagnostics_from_llm
        else:
            diagnostics = self._generate_diagnostics(checked_output, scores)

        return {
            **checked_output,
            "llm_judge": {
                "axis_scores": scores,
                "axis_scores_v1": v1_proxy,
                "per_model_scores": per_model_scores,
                "aggregation": self.aggregation if len(per_model_scores) > 1 else "single",
                "models_used": list(per_model_scores.keys()),
                "evidence": evidence,
                "llm_raw": round(raw, 3),
                "llm_structural_score": round(structural_score, 1),
                "llm_structural_score_v1": round(structural_score_v1, 1),
                **diagnostics,
            },
        }

    def _call_all_clients(self, data: dict) -> Dict[str, dict]:
        """모든 등록된 client를 순차 호출. 실패한 client는 skip."""
        user_prompt = self._build_user_prompt(data)
        results = {}

        for client in self.clients:
            provider_label = f"{client.name}:{client.model}"
            try:
                parsed = client.call(self.JUDGE_SYSTEM_PROMPT, user_prompt)
                # 점수 범위 검증
                for axis in self.WEIGHTS:
                    if axis in parsed:
                        parsed[axis] = max(1, min(5, int(parsed[axis])))
                results[provider_label] = parsed
                print(f"    ✓ {provider_label} 호출 성공")
            except Exception as e:
                err_msg = str(e)[:150]
                print(f"    ✗ {provider_label} 호출 실패: {err_msg}")

        return results

    def _aggregate_scores(self, results: Dict[str, dict]) -> dict:
        """여러 모델의 점수를 집계 (평균 또는 중간값)."""
        axes = list(self.WEIGHTS.keys())
        aggregated = {}

        for axis in axes:
            vals = [r.get(axis, 3) for r in results.values()]
            if self.aggregation == "median":
                vals_sorted = sorted(vals)
                n = len(vals_sorted)
                if n % 2 == 1:
                    aggregated[axis] = vals_sorted[n // 2]
                else:
                    aggregated[axis] = round((vals_sorted[n // 2 - 1] + vals_sorted[n // 2]) / 2)
            else:  # mean (기본)
                aggregated[axis] = round(sum(vals) / len(vals))
            aggregated[axis] = max(1, min(5, aggregated[axis]))

        return aggregated

    def _merge_diagnostics(self, results: Dict[str, dict]) -> dict:
        """여러 모델의 strengths/weaknesses를 합침 (중복 제거)"""
        strengths, weaknesses = [], []
        missing_techs, timing_issues, investment_issues = [], [], []

        for r in results.values():
            strengths.extend(r.get("key_strengths", []))
            weaknesses.extend(r.get("key_weaknesses", []))
            missing_techs.extend(r.get("missing_technologies", []))
            timing_issues.extend(r.get("timing_issues", []))
            investment_issues.extend(r.get("investment_issues", []))

        # 중복 제거 (순서 유지)
        def dedupe(lst):
            seen, out = set(), []
            for item in lst:
                if item not in seen:
                    seen.add(item)
                    out.append(item)
            return out

        return {
            "strengths": dedupe(strengths),
            "weaknesses": dedupe(weaknesses),
            "missing_technologies": dedupe(missing_techs),
            "timing_issues": dedupe(timing_issues),
            "investment_issues": dedupe(investment_issues),
        }

