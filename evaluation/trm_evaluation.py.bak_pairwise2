class AgentOutputNormalizer:
    """
    Step 1: Agent 출력 정규화
    - tech_candidates, planned_roadmap, investment_strategy를 tech_id 기준으로 병합
    - holdout 데이터에서 raw feature 계산 (log-ratio)
    - §7 원칙: 전체 universe 기준 min-max 정규화
    """

    COST_MAP = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}

    def run(self, input_pack: dict) -> dict:
        techs = {t["tech_id"]: t for t in input_pack["tech_candidates"]}
        roadmap = {r["tech_id"]: r for r in input_pack["planned_roadmap"]}
        invest = {s["tech_id"]: s for s in input_pack["investment_strategy"]}
        holdout = input_pack["holdout_data"]

        # ── raw feature 계산: 전체 universe ──
        # Supports two schemas:
        #   Legacy: past_patents / future_patents / past_market_size_m / future_market_size_m
        #   New    : baseline_patents / realized_patents / baseline_market_m / realized_market_m
        # baseline/realized는 시점 의미가 명확해서 권장.
        raw_features = {}
        for tid, hd in holdout.items():
            past = hd.get("baseline_patents", hd.get("past_patents"))
            future = hd.get("realized_patents", hd.get("future_patents"))
            past_m = hd.get("baseline_market_m", hd.get("past_market_size_m"))
            future_m = hd.get("realized_market_m", hd.get("future_market_size_m"))

            if None in (past, future, past_m, future_m):
                raise KeyError(
                    f"holdout_data[{tid}]에 필수 필드 누락. "
                    f"필요: baseline_patents/realized_patents/baseline_market_m/realized_market_m "
                    f"(또는 legacy: past_patents/future_patents/past_market_size_m/future_market_size_m)"
                )

            pg = math.log((future + 1) / (past + 1))
            mg = math.log((future_m + 1) / (past_m + 1))
            ms = math.log(future_m + 1)
            raw_features[tid] = {
                "patent_growth_raw": pg,
                "market_growth_raw": mg,
                "market_size_raw": ms
            }

        # ── §7: universe 전체 기준 min-max 정규화 ──
        all_pg = [f["patent_growth_raw"] for f in raw_features.values()]
        all_mg = [f["market_growth_raw"] for f in raw_features.values()]
        all_ms = [f["market_size_raw"] for f in raw_features.values()]

        def minmax(val, vals):
            # V2: None 처리 — 결측 시 중앙값 0.5
            if val is None:
                return 0.5
            valid = [v for v in vals if v is not None]
            if not valid:
                return 0.5
            lo, hi = min(valid), max(valid)
            if hi == lo:
                return 0.5
            return (val - lo) / (hi - lo)

        normalized = {}
        for tid, feat in raw_features.items():
            normalized[tid] = {
                "patent_growth_norm": minmax(feat["patent_growth_raw"], all_pg),
                "market_growth_norm": minmax(feat["market_growth_raw"], all_mg),
                "market_size_norm": minmax(feat["market_size_raw"], all_ms),
                **feat  # raw도 보관
            }

        # ── 선택된 기술만 병합 ──
        selected_ids = [r["tech_id"] for r in input_pack["planned_roadmap"]]
        merged = []
        for tid in selected_ids:
            entry = {
                "tech_id": tid,
                "tech_name": techs[tid]["tech_name"],
                "category": techs[tid]["category"],
                "TRL": techs[tid]["TRL"],
                "expected_market_boom_quarter": techs[tid]["expected_market_boom_quarter"],
                "dependency_hints": techs[tid]["dependency_hints"],
                "keywords": techs[tid]["keywords"],
                # roadmap
                "start_q": roadmap[tid]["start_q"],
                "target_q": roadmap[tid]["target_q"],
                "prerequisites": roadmap[tid]["prerequisites"],
                # investment
                "investment_tier": invest[tid]["investment_tier"],
                "market_opportunity": invest[tid]["market_opportunity"],
                "strategic_fit": invest[tid]["strategic_fit"],
                "executability": invest[tid]["executability"],
                "uncertainty": invest[tid]["uncertainty"],
                "urgency": invest[tid]["urgency"],
                # holdout-based normalized features
                "patent_growth_norm": normalized[tid]["patent_growth_norm"],
                "market_growth_norm": normalized[tid]["market_growth_norm"],
                "market_size_norm": normalized[tid]["market_size_norm"],
                "patent_growth_raw": normalized[tid]["patent_growth_raw"],
                "market_growth_raw": normalized[tid]["market_growth_raw"],
                "market_size_raw": normalized[tid]["market_size_raw"],
                # cost proxy
                "cost_proxy": self.COST_MAP.get(invest[tid]["investment_tier"], 2),
                "tech_budget_usd": invest[tid].get("tech_budget_usd", 0) or 0
            }
            merged.append(entry)

        return {
            "merged_techs": merged,
            "universe_normalized": normalized,
            "constraints": input_pack["constraints"],
            "metadata": input_pack["metadata"]
        }


class ConstraintChecker:
    """
    Step 2: Hard Constraint 위반 검사
    - 예산 초과
    - 의존성(선행관계) 위반
    - 타이밍 오류 (시장 개화 시점 vs 개발 완료 시점)
    """

    @staticmethod
    def _q_to_float(q_str: str) -> float:
        """'2027-Q3' → 2027.5 식으로 변환"""
        year, q = q_str.split("-")
        quarter = int(q.replace("Q", ""))
        return int(year) + (quarter - 1) * 0.25

    def run(self, norm_output: dict) -> dict:
        techs = norm_output["merged_techs"]
        constraints = norm_output["constraints"]

        # ── 예산 검사 ──
        budget_total = constraints["total_budget"]
        budget_alloc = constraints.get("budget_allocation", {})
        # 실제 기술별 예산(tech_budget_usd) 합산; 없으면 기존 tier 기반 fallback
        _real_budgets = [t.get("tech_budget_usd", 0) or 0 for t in techs]
        if any(_real_budgets):
            spent = sum(_real_budgets)  # raw USD (constraints.total_budget도 raw USD)
        else:
            spent = sum(budget_alloc.get(t["investment_tier"], 0) for t in techs)
        budget_violation = max(0, spent - budget_total)
        budget_violation_pct = (budget_violation / budget_total * 100) if budget_total > 0 else 0

        # ── 의존성 검사 ──
        target_map = {}
        for t in techs:
            target_map[t["tech_id"]] = self._q_to_float(t["target_q"])

        dep_violations = []
        for t in techs:
            start = self._q_to_float(t["start_q"])
            for pre_id in t["prerequisites"]:
                if pre_id in target_map:
                    pre_end = target_map[pre_id]
                    if start < pre_end:
                        dep_violations.append({
                            "tech_id": t["tech_id"],
                            "tech_name": t["tech_name"],
                            "prerequisite": pre_id,
                            "tech_start": t["start_q"],
                            "prereq_end": f"~{pre_end}",
                            "gap_quarters": round((start - pre_end) * 4, 1)
                        })

        # ── 타이밍 검사: target_q vs expected_market_boom_quarter ──
        timing_errors = []
        for t in techs:
            if t["expected_market_boom_quarter"]:
                target = self._q_to_float(t["target_q"])
                boom = self._q_to_float(t["expected_market_boom_quarter"])
                error_years = target - boom  # 양수면 시장보다 늦음
                timing_errors.append({
                    "tech_id": t["tech_id"],
                    "tech_name": t["tech_name"],
                    "target_q": t["target_q"],
                    "boom_q": t["expected_market_boom_quarter"],
                    "error_years": round(error_years, 2)
                })

        mean_timing_error = 0
        if timing_errors:
            mean_timing_error = sum(abs(e["error_years"]) for e in timing_errors) / len(timing_errors)

        return {
            **norm_output,
            "constraint_results": {
                "budget_violation_pct": round(budget_violation_pct, 1),
                "budget_spent": spent,
                "budget_total": budget_total,
                "dependency_violations": dep_violations,
                "dependency_violation_count": len(dep_violations),
                "timing_errors": timing_errors,
                "mean_timing_error_years": round(mean_timing_error, 2)
            }
        }


class BaseLLMClient(ABC):
    """
    LLM Provider 추상화 클래스.
    모든 provider는 (system_prompt, user_prompt) → JSON dict를 반환.
    """
    name: str = "base"
    default_model: str = ""

    def __init__(self, api_key: Optional[str] = None, model: Optional[str] = None):
        self.api_key = api_key
        self.model = model or self.default_model

    @abstractmethod
    def call(self, system_prompt: str, user_prompt: str, max_tokens: int = 1500) -> dict:
        """JSON object를 반환. 실패 시 예외."""
        pass

    @staticmethod
    def _parse_json(text: str) -> dict:
        """LLM 응답에서 JSON 추출 (```json 래핑, 앞뒤 텍스트 처리)"""
        text = re.sub(r"```json\s*", "", text)
        text = re.sub(r"```\s*", "", text)
        text = text.strip()
        # 첫 { 부터 마지막 } 까지만 추출 (LLM이 앞뒤에 설명 붙였을 수 있음)
        start = text.find("{")
        end = text.rfind("}")
        if start >= 0 and end > start:
            text = text[start : end + 1]
        return json.loads(text)


class AnthropicClient(BaseLLMClient):
    """Claude (Anthropic) — Messages API 직접 호출"""
    name = "anthropic"
    default_model = "claude-sonnet-4-6"

    def __init__(self, api_key: Optional[str] = None, model: Optional[str] = None):
        key = api_key or os.environ.get("ANTHROPIC_API_KEY")
        super().__init__(key, model)

    def call(self, system_prompt: str, user_prompt: str, max_tokens: int = 1500) -> dict:
        if not self.api_key:
            raise RuntimeError("ANTHROPIC_API_KEY not set")

        payload = {
            "model": self.model,
            "max_tokens": max_tokens,
            "system": system_prompt,
            "messages": [{"role": "user", "content": user_prompt}],
        }
        headers = {
            "Content-Type": "application/json",
            "x-api-key": self.api_key,
            "anthropic-version": "2023-06-01",
        }
        with httpx.Client(timeout=60) as client:
            resp = client.post(
                "https://api.anthropic.com/v1/messages",
                headers=headers,
                json=payload,
            )
            resp.raise_for_status()
            result = resp.json()

        text = ""
        for block in result.get("content", []):
            if block.get("type") == "text":
                text += block["text"]
        return self._parse_json(text)


class OpenAIClient(BaseLLMClient):
    """GPT-4o / GPT-4.1 (OpenAI) — Chat Completions API"""
    name = "openai"
    default_model = "gpt-4o"

    def __init__(self, api_key: Optional[str] = None, model: Optional[str] = None):
        if not _HAS_OPENAI:
            raise ImportError("openai package not installed. Run: pip install openai")
        key = api_key or os.environ.get("OPENAI_API_KEY")
        super().__init__(key, model)
        self._client = OpenAI(api_key=self.api_key) if self.api_key else None

    def call(self, system_prompt: str, user_prompt: str, max_tokens: int = 1500) -> dict:
        if not self._client:
            raise RuntimeError("OPENAI_API_KEY not set")

        resp = self._client.chat.completions.create(
            model=self.model,
            max_tokens=max_tokens,
            response_format={"type": "json_object"},  # JSON mode 강제
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt},
            ],
        )
        text = resp.choices[0].message.content
        return self._parse_json(text)


class GeminiClient(BaseLLMClient):
    """Gemini (Google) — google-genai SDK"""
    name = "gemini"
    default_model = "gemini-2.0-flash-001"

    def __init__(self, api_key: Optional[str] = None, model: Optional[str] = None):
        if not _HAS_GEMINI:
            raise ImportError("google-genai package not installed. Run: pip install google-genai")
        key = api_key or os.environ.get("GOOGLE_API_KEY") or os.environ.get("GEMINI_API_KEY")
        super().__init__(key, model)
        self._client = google_genai.Client(api_key=self.api_key) if self.api_key else None

    def call(self, system_prompt: str, user_prompt: str, max_tokens: int = 1500) -> dict:
        if not self._client:
            raise RuntimeError("GOOGLE_API_KEY (or GEMINI_API_KEY) not set")

        # Gemini는 system을 config.system_instruction으로 분리
        from google.genai import types
        resp = self._client.models.generate_content(
            model=self.model,
            contents=user_prompt,
            config=types.GenerateContentConfig(
                system_instruction=system_prompt,
                max_output_tokens=max_tokens,
                response_mime_type="application/json",
            ),
        )
        text = resp.text
        return self._parse_json(text)


def make_client(provider: str, api_key: Optional[str] = None,
                model: Optional[str] = None) -> BaseLLMClient:
    """Provider 이름으로 client 생성"""
    p = provider.lower()
    if p in ("anthropic", "claude"):
        return AnthropicClient(api_key, model)
    elif p in ("openai", "gpt"):
        return OpenAIClient(api_key, model)
    elif p in ("google", "gemini"):
        return GeminiClient(api_key, model)
    else:
        raise ValueError(f"Unknown provider: {provider}. Use 'anthropic', 'openai', or 'gemini'.")


class LLMStructuralJudge:
    """
    Step 3: LLM-as-a-Judge 구조 평가
    - 5개 축 (1~5점) 평가
    - §3 가중치로 structural score 계산
    - ACCEPT/REVISE 없이 scoring만 수행

    4가지 모드:
      1) llm_scores 직접 전달 → 그대로 사용
      2) 단일 client → 해당 provider만 호출
      3) 앙상블 (여러 client) → 축별 평균 집계
      4) client 없음 → rule-based proxy (fallback)

    사용법:
