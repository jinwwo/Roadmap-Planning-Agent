class PairwiseComparator:
    """§10: 두 시나리오를 나란히 비교"""

    def compare(self, report_a: dict, report_b: dict) -> dict:
        axes = ["trl_pathway", "strategic_fidelity", "competitive_awareness",
                "market_timing", "patent_market_convergence"]
        axis_comparison = {}
        for ax in axes:
            va = report_a["llm_judge"].get(ax, 0)
            vb = report_b["llm_judge"].get(ax, 0)
            axis_comparison[ax] = {
                "A": va, "B": vb,
                "winner": "A" if va > vb else "B" if vb > va else "Tie"
            }

        bt_keys = [
            "selection_quality", "cost_adjusted_return",
            "budget_feasibility_score",
            "dependency_validity_score", "timing_accuracy_score"
        ]
        bt_comparison = {}
        for k in bt_keys:
            va = report_a["backtest"].get(k, 0)
            vb = report_b["backtest"].get(k, 0)
            bt_comparison[k] = {
                "A": va, "B": vb,
                "winner": "A" if va > vb else "B" if vb > va else "Tie"
            }

        fa = report_a["composite"]["final_composite_score"]
        fb = report_b["composite"]["final_composite_score"]

        return {
            "mode": "pairwise",
            "scenario_A": report_a["metadata"]["scenario"],
            "scenario_B": report_b["metadata"]["scenario"],
            "llm_judge_comparison": {
                "axis_detail": axis_comparison,
                "score_A": report_a["llm_judge"]["llm_structural_score"],
                "score_B": report_b["llm_judge"]["llm_structural_score"],
                "llm_winner": "A" if report_a["llm_judge"]["llm_structural_score"] >
                              report_b["llm_judge"]["llm_structural_score"] else "B"
            },
            "backtest_comparison": {
                "metric_detail": bt_comparison,
                "score_A": report_a["backtest"]["backtest_score"],
                "score_B": report_b["backtest"]["backtest_score"],
                "backtest_winner": "A" if report_a["backtest"]["backtest_score"] >
                                   report_b["backtest"]["backtest_score"] else "B"
            },
            "final_comparison": {
                "score_A": fa,
                "score_B": fb,
                "delta": round(abs(fa - fb), 1),
                "final_winner": "A" if fa > fb else "B" if fb > fa else "Tie"
            }
        }


