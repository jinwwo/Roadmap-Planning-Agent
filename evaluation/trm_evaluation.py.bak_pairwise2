                "mode": "absolute",
                "reference_year": meta["evaluation_cutoff_year"],
                "domain": meta["domain"],
                "num_technologies": len(techs)
            },
            "llm_judge": {
                **llm["axis_scores"],
                "llm_structural_score": llm["llm_structural_score"],
                "aggregation": llm.get("aggregation", "single"),
                "models_used": llm.get("models_used", []),
                "per_model_scores": llm.get("per_model_scores", {}),
                "evidence": llm.get("evidence", {}),
                "strengths": llm["strengths"],
                "weaknesses": llm["weaknesses"],
                "missing_technologies": llm["missing_technologies"],
                "investment_issues": llm["investment_issues"],
                "timing_issues": llm["timing_issues"],
                "description": self._describe_llm(llm, techs, cr),
                "v1_scores": {
                    **llm.get("axis_scores_v1", {}),
                    "llm_structural_score_v1": llm.get("llm_structural_score_v1", 0),
                },
            },
            "backtest": {
                "tech_details": bt["tech_details"],
                "selection_quality": bt["selection_quality"],
                "cost_adjusted_return": bt["cost_adjusted_return"],
                "budget_feasibility_score": bt["budget_feasibility_score"],
                "dependency_validity_score": bt["dependency_validity_score"],
                "timing_accuracy_score": bt["timing_accuracy_score"],
                "backtest_score": bt["backtest_score"],
                "backtest_score_v1": bt.get("backtest_score_v1", 0),
                "description": self._describe_backtest(bt, cr, techs),
            },
            "constraints": {
                "budget_violation_pct": cr["budget_violation_pct"],
                "dependency_violations": cr["dependency_violation_count"],
                "dependency_details": cr["dependency_violations"],
                "mean_timing_error_years": cr["mean_timing_error_years"],
                "timing_details": cr["timing_errors"]
            },
            "composite": {
                **comp,
                "description": self._describe_composite(llm, bt, comp),
            },
            "diagnostics": {
                "summary": self._generate_summary(llm, bt, comp),
                "key_failure_points": self._find_failures(cr, bt),
                "comparison_note": "pairwise mode를 사용하여 다른 시나리오와 비교하세요."
            }
        }

    # ── Description 생성 ──

    def _describe_llm(self, llm, techs, cr) -> dict:
        """LLM Judge 각 축 점수의 XAI 분석"""
        axes = llm["axis_scores"]
        # V2 분기: 새 5축이면 evidence 기반 description 반환
        if "trl_pathway" in axes:
            ev = llm.get("evidence", {})
            w = LLMStructuralJudge.WEIGHTS
            d = {}
            for k in w:
                d[k] = f"score {axes.get(k, 3)}/5 - " + ev.get(k, "")
            mul = chr(0x00D7)
            fp = " + ".join(f"{w[k]}{mul}{axes.get(k, 3)}" for k in w)
            d["formula"] = f"llm_structural_score = ({fp} - 1) / 4 {mul} 100 = {llm.get(chr(108)+chr(108)+chr(109)+chr(95)+chr(115)+chr(116)+chr(114)+chr(117)+chr(99)+chr(116)+chr(117)+chr(114)+chr(97)+chr(108)+chr(95)+chr(115)+chr(99)+chr(111)+chr(114)+chr(101), 0)}"
            return d
        categories = {}
        for t in techs:
            cat = t.get("category", "Unknown")
            categories[cat] = categories.get(cat, 0) + 1
        tiers = {}
        for t in techs:
            tier = t.get("investment_tier", "Medium")
            tiers[tier] = tiers.get(tier, 0) + 1
        trl_vals = [t.get("TRL", t.get("trl", 5)) for t in techs]
        trl_range = f"{min(trl_vals)}~{max(trl_vals)}" if trl_vals else "N/A"
        dep_count = cr.get("dependency_violation_count", 0)
        dep_details = cr.get("dependency_violations", [])

        # alignment 상세: 어떤 기술의 시장 성장률이 높고 낮은지
        merged = [t for t in techs if "market_growth_norm" in t]
        if merged:
            sorted_by_mg = sorted(merged, key=lambda x: x.get("market_growth_norm", 0), reverse=True)
            top = sorted_by_mg[0]
            bottom = sorted_by_mg[-1]
            align_detail = (
                f"점수 {axes['alignment']}/5.\n"
                f"  시장 성장률 기준 최고: {top.get('tech_name', top.get('tech_id'))} "
                f"(norm={top.get('market_growth_norm', 0):.3f})\n"
                f"  시장 성장률 기준 최저: {bottom.get('tech_name', bottom.get('tech_id'))} "
                f"(norm={bottom.get('market_growth_norm', 0):.3f})\n"
                f"  전체 평균: {sum(t.get('market_growth_norm', 0) for t in merged)/len(merged):.3f}"
            )
        else:
            align_detail = f"점수 {axes['alignment']}/5 — holdout 데이터 기반 시장 성장률 평균."

        # sequencing 상세: 위반 건 구체적 나열
        if dep_count == 0:
            seq_detail = f"점수 {axes['sequencing']}/5 — 의존성 위반 0건. 모든 선행관계가 올바르게 구성됨."
        else:
            violations = []
            for dv in dep_details:
                violations.append(
                    f"  ⚠ {dv.get('tech_name', '?')}이 선행기술 {dv.get('prerequisite', '?')} "
                    f"완료 전 시작 (gap: {dv.get('gap_quarters', '?')}Q)"
                )
            seq_detail = (
                f"점수 {axes['sequencing']}/5 — 의존성 위반 {dep_count}건:\n"
                + "\n".join(violations)
            )

        # investment 상세: 어떤 기술이 tier 불일치인지
        mismatches = []
        for t in techs:
            value = t.get("value", 0)
            actual_tier = t.get("investment_tier", "Medium")
            # 기대 tier 계산
            expected_cost = 1
            if value > 0.5:
                expected_cost += 1
            if value > 0.7:
                expected_cost += 1
            expected_cost = min(4, expected_cost)
            cost_map = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}
            actual_cost = cost_map.get(actual_tier, 2)
            if abs(actual_cost - expected_cost) > 1:
                rev_map = {1: "Low", 2: "Medium", 3: "High", 4: "Strategic"}
                mismatches.append(
                    f"  ⚠ {t.get('tech_name', t.get('tech_id'))}: "
                    f"value={value:.3f} → 기대 {rev_map.get(expected_cost, '?')}, "
                    f"실제 {actual_tier} (차이 {abs(actual_cost - expected_cost)}단계)"
                )
        if mismatches:
            inv_detail = (
                f"점수 {axes['investment']}/5 — tier 불일치 {len(mismatches)}건:\n"
                + "\n".join(mismatches)
            )
        else:
            inv_detail = f"점수 {axes['investment']}/5 — 모든 기술의 value 대비 투자등급이 적절함."

        # coherence 상세
        cat_str = ", ".join(f"{k}({v}개)" for k, v in sorted(categories.items(), key=lambda x: -x[1]))
        coher_detail = (
            f"점수 {axes['coherence']}/5\n"
            f"  카테고리 분포: {cat_str}\n"
            f"  TRL 범위: {trl_range}\n"
            f"  {'다양한 카테고리와 넓은 TRL 범위 → 높은 점수' if axes['coherence'] >= 4 else '카테고리 편중 또는 TRL 범위 좁음'}"
        )

        # balance 상세
        tier_str = ", ".join(f"{k}({v}개)" for k, v in sorted(tiers.items()))
        missing_tiers = [t for t in ["Strategic", "High", "Medium", "Low"] if t not in tiers]
        balance_detail = (
            f"점수 {axes['balance']}/5\n"
            f"  투자등급 분포: {tier_str}\n"
            + (f"  없는 등급: {', '.join(missing_tiers)}" if missing_tiers else "  모든 등급 사용")
        )

        formula = (
            f"llm_structural_score = (0.3×{axes['alignment']} + 0.2×{axes['sequencing']} "
            f"+ 0.2×{axes['investment']} + 0.2×{axes['coherence']} "
            f"+ 0.1×{axes['balance']} - 1) / 4 × 100 = {llm['llm_structural_score']:.1f}"
        )

        return {
            "alignment": align_detail,
            "sequencing": seq_detail,
            "investment": inv_detail,
            "coherence": coher_detail,
            "balance": balance_detail,
            "formula": formula,
        }

    def _describe_backtest(self, bt, cr, techs) -> dict:
        """Back Test 각 지표의 XAI 분석 — 기술별 기여도 + 원인 진단"""
        td = bt.get("tech_details", [])

        # ── selection_quality: 기술별 value 분해 ──
        if td:
            sorted_by_value = sorted(td, key=lambda x: x.get("value", 0), reverse=True)
            avg_val = sum(t.get("value", 0) for t in td) / len(td)
            tech_lines = []
            for t in sorted_by_value:
                v = t.get("value", 0)
                contrib = "▲" if v > avg_val else "▼"
                pg = t.get("patent_growth_norm", 0)
                mg = t.get("market_growth_norm", 0)
                ms = t.get("market_size_norm", 0)
                tech_lines.append(
                    f"  {contrib} {t.get('tech_name', '?')}: value={v:.3f} "
                    f"(특허↑={pg:.2f}, 시장↑={mg:.2f}, 규모={ms:.2f})"
                )
            sq_detail = (
                f"{bt['selection_quality']:.1f}/100 — {len(td)}개 기술 평균 value={avg_val:.3f}\n"
                + "\n".join(tech_lines)
            )
            # 점수가 낮은 원인 진단
            low_techs = [t for t in td if t.get("value", 0) < 0.3]
            if low_techs:
                reasons = []
                for t in low_techs:
                    pg = t.get("patent_growth_norm", 0)
                    mg = t.get("market_growth_norm", 0)
                    if pg < 0.3:
                        reasons.append(f"  → {t.get('tech_name')}: 특허 성장률 낮음 (norm={pg:.2f})")
                    if mg < 0.3:
                        reasons.append(f"  → {t.get('tech_name')}: 시장 성장률 낮음 (norm={mg:.2f})")
                if reasons:
                    sq_detail += "\n  [낮은 원인]\n" + "\n".join(reasons)
        else:
            sq_detail = f"{bt['selection_quality']:.1f}/100 — 기술 데이터 없음"

        # ── cost_adjusted_return: 기술별 투자 효율 ──
        if td:
            sorted_by_ret = sorted(td, key=lambda x: x.get("cost_adjusted_return", 0), reverse=True)
            avg_ret = sum(t.get("cost_adjusted_return", 0) for t in td) / len(td)
            ret_lines = []
            for t in sorted_by_ret:
                v = t.get("value", 0)
                ret = t.get("cost_adjusted_return", 0)
                tier = t.get("investment_tier", "?")
                cost_map = {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}
                cost = cost_map.get(tier, 2)
                cost_norm = (cost - 1) / 3
                flag = ""
                if v < 0.4 and cost >= 3:
                    flag = " ⚠ 과다투자"
                elif v > 0.6 and cost <= 1:
                    flag = " ★ 효율적"
                ret_lines.append(
                    f"  {t.get('tech_name', '?')}: value={v:.3f} - 0.15×{cost_norm:.2f}(cost) "
                    f"= return {ret:+.3f} [{tier}]{flag}"
                )
            car_detail = (
                f"{bt['cost_adjusted_return']:.1f}/100 — 평균 return={avg_ret:.3f}\n"
                + "\n".join(ret_lines)
            )
            overinvested = [t for t in td if t.get("value", 0) < 0.4 and 
                           {"Low": 1, "Medium": 2, "High": 3, "Strategic": 4}.get(t.get("investment_tier"), 2) >= 3]
            if overinvested:
                car_detail += "\n  [과다투자 진단]"
                for t in overinvested:
                    car_detail += f"\n  → {t.get('tech_name')}: value {t.get('value', 0):.3f}인데 {t.get('investment_tier')} tier"
        else:
            car_detail = f"{bt['cost_adjusted_return']:.1f}/100"

        # ── budget_feasibility ──
        bvp = cr.get("budget_violation_pct", 0)
        bf_detail = (
            f"{bt['budget_feasibility_score']:.1f}/100 — "
            + ("예산 내 집행." if bvp == 0 else f"예산 {bvp:.1f}% 초과.")
        )

        # ── dependency_validity ──
        dep_count = cr.get("dependency_violation_count", 0)
        if dep_count == 0:
            dv_detail = f"{bt['dependency_validity_score']:.1f}/100 — 의존성 위반 0건. 전체 선행관계 준수."
        else:
            dv_lines = []
            for dv in cr.get("dependency_violations", []):
                dv_lines.append(
                    f"  ⚠ {dv.get('tech_name')}: 선행 {dv.get('prerequisite')} 완료 전 시작 "
                    f"(gap: {dv.get('gap_quarters')}Q)"
                )
            dv_detail = (
                f"{bt['dependency_validity_score']:.1f}/100 — 위반 {dep_count}건 (1건당 -20점)\n"
                + "\n".join(dv_lines)
            )

        # ── timing_accuracy ──
        mte = cr.get("mean_timing_error_years", 0)
        timing_errors = cr.get("timing_errors", [])
        if timing_errors:
            sorted_te = sorted(timing_errors, key=lambda x: abs(x.get("error_years", 0)), reverse=True)
            te_lines = []
            for te in sorted_te:
                err = te.get("error_years", 0)
                direction = "늦음" if err > 0 else "이름"
                flag = " ⚠" if abs(err) > 1 else ""
                te_lines.append(
                    f"  {te.get('tech_name')}: {abs(err):.1f}년 {direction}{flag}"
                )
            ta_detail = (
                f"{bt['timing_accuracy_score']:.1f}/100 — 평균 오차 {mte:.2f}년\n"
                + "\n".join(te_lines)
            )
        else:
            ta_detail = f"{bt['timing_accuracy_score']:.1f}/100 — 평균 오차 {mte:.2f}년"

        # ── formula ──
        formula = (
            f"backtest_score = 0.35×{bt['selection_quality']:.1f} + 0.35×{bt['cost_adjusted_return']:.1f} "
            f"+ 0.05×{bt['budget_feasibility_score']:.1f} "
            f"+ 0.05×{bt['dependency_validity_score']:.1f} + 0.10×{bt['timing_accuracy_score']:.1f} "
            f"= {bt['backtest_score']:.1f}"
        )

        return {
            "selection_quality": sq_detail,
            "cost_adjusted_return": car_detail,
            "budget_feasibility": bf_detail,
            "dependency_validity": dv_detail,
            "timing_accuracy": ta_detail,
            "formula": formula,
        }

    def _describe_composite(self, llm, bt, comp) -> str:
        """Composite 점수 XAI 분석"""
        penalty_parts = []
        for p in comp.get("penalties", []):
            penalty_parts.append(f"{p['type']}: -{p['amount']:.1f}pt")

        penalty_str = "페널티 없음."
        if comp["total_penalty"] > 0:
            penalty_str = f"Penalty: {', '.join(penalty_parts)}. 총 -{comp['total_penalty']:.1f}pt."

        # 어느 축이 점수를 끌어내리는지 진단
        llm_score = llm["llm_structural_score"]
        bt_score = bt["backtest_score"]
        
        diagnosis = ""
        if llm_score < 50:
            diagnosis += f"\n  [진단] LLM 구조 점수({llm_score:.1f})가 낮음 → 로드맵 구조 개선 필요."
        if bt_score < 50:
            diagnosis += f"\n  [진단] Backtest 점수({bt_score:.1f})가 낮음 → 기술 선택 또는 투자 배분 재검토."
        if comp["total_penalty"] > 10:
            diagnosis += f"\n  [진단] 페널티(-{comp['total_penalty']:.1f})가 큼 → 의존성/예산/타이밍 제약 위반 해소 필요."
        
        gap = abs(llm_score - bt_score)
        if gap > 20:
            if llm_score > bt_score:
                diagnosis += f"\n  [진단] LLM({llm_score:.1f})과 Backtest({bt_score:.1f}) 격차 {gap:.1f}pt → 구조는 좋지만 실제 데이터 뒷받침 부족."
            else:
                diagnosis += f"\n  [진단] Backtest({bt_score:.1f})가 LLM({llm_score:.1f})보다 {gap:.1f}pt 높음 → 좋은 기술 선택이지만 로드맵 구조 정비 필요."

        return (
            f"pre_penalty = 0.4×{llm_score:.1f}(LLM) "
            f"+ 0.6×{bt_score:.1f}(Backtest) = {comp['pre_penalty_score']:.1f}. "
            f"{penalty_str} "
            f"최종 = {comp['final_composite_score']:.1f}."
            f"{diagnosis}"
        )

    def _generate_summary(self, llm, bt, comp) -> str:
        parts = []
        parts.append(f"LLM 구조 평가 {llm['llm_structural_score']}점, "
                      f"Backtest 경제성 평가 {bt['backtest_score']}점.")
        if comp["total_penalty"] > 0:
            parts.append(f"제약 위반으로 {comp['total_penalty']}점 차감.")
        parts.append(f"최종 Composite Score: {comp['final_composite_score']}점.")
        return " ".join(parts)

    def _find_failures(self, cr, bt) -> list:
        failures = []
        for dv in cr["dependency_violations"]:
            failures.append(
                f"의존성 위반: {dv['tech_name']}이 선행기술 {dv['prerequisite']} "
                f"완료 전에 시작 (gap: {dv['gap_quarters']}Q)"
            )
        for te in cr["timing_errors"]:
            if abs(te["error_years"]) > 1:
                failures.append(
                    f"타이밍 이슈: {te['tech_name']}의 완료시점이 "
                    f"시장 개화 대비 {te['error_years']}년 차이"
                )
        return failures


