# ─────────────────────────────────────────────────────────────
# Technology Roadmap Multi-Agent System — 공용 .env 템플릿
# ─────────────────────────────────────────────────────────────
# 이 파일을 `.env` 로 복사한 뒤 필요한 값을 채워 넣으세요.
# 4개 sibling 에이전트 (tech_analysis / roadmap_planner /
# investment_strategist / orchestration) 이 모두 같은 변수 이름을 사용합니다.
#
# 공통 관례:
#   - `.env` 는 repo 루트(Roadmap-Planning-Agent/)에 두고 각 에이전트
#     폴더에서 symlink (`.env -> ../.env`) 로 참조하도록 세팅 됩니다.
#     — 한 곳만 수정하면 4개 에이전트에 동시 반영됨.

# ── LLM provider 선택 ─────────────────────────────────────────
# "anthropic" : Claude API  (품질 ↑, 유료)
# "ollama"    : 로컬 Ollama (무료, 사전 설치 + 모델 pull 필요)
LLM_PROVIDER=ollama

# ── Anthropic Claude (provider=anthropic 일 때 필수) ─────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Ollama (provider=ollama 일 때 사용) ──────────────────────
# 권장 모델:
#   - gemma3:27b   — 기본 권장, 한국어/JSON 안정성 및 agent 추론 품질 균형
#   - qwen3:32b    — Qwen 계열 대안
#   - qwen2.5:14b  — 더 가벼운 안정 대안
#   - llama3.1:8b  — 경량 데모용 (한국어/JSON 약함)
OLLAMA_MODEL=gemma3:27b
OLLAMA_BASE_URL=http://localhost:11434

# ── 실제 데이터 API ─────────────────────────────────────────
# USE_MOCK_*=0 일 때는 각 API key 를 설정해야 합니다.
TAVILY_API_KEY=
PATENTSVIEW_API_KEY=
USE_MOCK_MARKET=0
USE_MOCK_PATENT=0

# ── Orchestration Agent 설정 ─────────────────────────────────
MAX_ORCHESTRATOR_ITERATIONS=2
SUBPROCESS_TIMEOUT_SEC=900

# ── Ollama 고급 옵션 (선택) ──────────────────────────────────
# 컨텍스트 윈도우 (default 16384).
# 큰 모델 (27b 등) 사용 시 num_ctx 큰 값이 KV cache 메모리 ↑ → GPU 부족 → CPU fallback.
# 권장값:
#   - gemma3:27b on A100/large GPU: 32768
#   - qwen/gemma 27B on smaller GPU: 4096-16384
#   - 8B/9B class models          : 16384
OLLAMA_NUM_CTX=32768
#
# Qwen3 thinking 모드 비활성화 옵션. Gemma 계열에는 영향이 거의 없지만
# Qwen3 계열로 바꿀 경우 format=json 충돌을 줄이는 안전장치입니다.
OLLAMA_NO_THINK=0
#
# Investment Strategist 의 LLM 강도 강제 override (default auto).
# - "single_call" : 모든 stage 한 번에 (강한 LLM 권장)
# - "per_stage"   : stage 별 분할 (작은 LLM 권장)
# 비워두면 자동 (모델명 패턴으로 판별).
# STRATEGIST_LLM_STRATEGY=

# ── Qwen3 thinking + format=json 충돌 회피 옵션 ──────────────
# Qwen3 hybrid reasoning 모델은 답변 시작 시 <think>...</think> 를 출력하는데
# Ollama 의 format=json 이 첫 토큰을 JSON grammar 로 강제 → 즉시 종료 → 빈 응답 버그.
#
# OLLAMA_FORMAT_JSON=0 : format=json 끔. 모델이 자유 출력 → 코드의 _extract_json
#                       이 <think> 블록 제거 후 JSON regex 추출. (권장)
# OLLAMA_FORMAT_JSON=1 (또는 미설정): format=json 사용 (Qwen2.5/llama3 등 non-reasoning 모델용)
# Gemma3 기본값에서는 format=json=1 권장 (JSON syntax 강제).
OLLAMA_FORMAT_JSON=1
#
# num_predict 의 "최소 보장 floor". 호출자가 더 큰 max_tokens 를 요청하면(예: Strategist
# single-call 의 16384) 그 값을 그대로 사용. 호출자가 이보다 작으면(예: Intake 의 512)
# 이 값으로 끌어올려 thinking 잔여 토큰 여유 확보.
#   - gemma3:27b: 2048 권장 (작은 호출이 잘리지 않을 만큼)
#   - 일반 모델: 미설정해도 OK
OLLAMA_NUM_PREDICT=2048

# ── Roadmap Planner — tech_selector 옵션 ────────────────────
# 후보 기술이 많을 때 selector 가 LLM 자율 판단으로 줄이고, 다음 노드로
# K개만 흘려보냄. 이 변수는 그 K 의 "최소 보장" floor (default 3).
# 후보 수가 K_MIN 이하면 selector 호출 없이 모두 통과.
# ROADMAP_TECH_K_MIN=3

# ── Roadmap Planner — 설계 모드 ─────────────────────────────
# Roadmap Planner 의 timeline 결정 방식을 선택.
#
# "holistic" (default) — spec 의 LLM 통합 모드:
#     tech_selector → roadmap_designer (LLM 한 번에 dependency + lead_time +
#                                       backcasting + phase_name + justification)
#     · 자연스러운 horizon 분포, 의미적 단계 구성
#     · 단점: 결정성 ↓ (LLM 비결정성), TRL lead_time 정확성 약화
#
# "hybrid" — 옛 모드 (Python 알고리즘 + LLM 보강):
#     tech_selector → dependency_analyzer (LLM) → timeline_calculator (Python) →
#                     roadmap_builder (LLM)
#     · 결정성 ↑ (TRL 기반 lead_time 강제, Zero-slack 검증 코드)
#     · 단점: chain sparse 시 timeline 이 한 시점에 몰리는 경향
#
# ROADMAP_DESIGN_MODE=holistic
