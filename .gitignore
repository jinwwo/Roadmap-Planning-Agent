# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
.venv/
venv/
env/

# Environment files (각 에이전트 폴더의 .env 는 symlink 이지만 위 규칙에 포함)
.env
*/.env

# Outputs (orchestration_agent 산출물 — 세션 보고서는 협업자 공유 위해 tracking)
# .json / .md / .html 모두 commit 함
!orchestration_agent/outputs/.gitkeep

# Per-agent standalone 실행 산출물
*/output_*.json

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Run logs
.run/
